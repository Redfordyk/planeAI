# Local MediaWiki (Angela docs) — copy to .env and adjust.
# This stack is meant to run on a developer PC, not the server.

MW_PORT=8080

# Database (MariaDB) — used by the MediaWiki installer.
MW_DB_NAME=mediawiki
MW_DB_USER=wikiuser
MW_DB_PASS=change-me-wiki
MW_DB_ROOT_PASS=change-me-root

# After running the web installer at http://localhost:8080, create a
# bot password under Special:BotPasswords and put it here, then set the
# backend env vars (see Angela/wiki/docker-compose.yml header):
#   ANGELA_WIKI_URL=http://localhost:8080
#   ANGELA_WIKI_USER=Angela
#   ANGELA_WIKI_PASSWORD=<bot password>
