# Plane CE local deploy — env template
# Copy to .env and adjust. Real .env is gitignored.
# This is a copy of deployments/cli/community/variables.env with port overrides
# documented in ../README-deploy.md.

APP_DOMAIN=localhost
APP_RELEASE=stable

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

# Local dry-run: 80/443 are usually taken on Windows; use 8088/8443.
# On the production server set these back to 80/443.
LISTEN_HTTP_PORT=8088
LISTEN_HTTPS_PORT=8443

WEB_URL=http://${APP_DOMAIN}:8088
DEBUG=0
CORS_ALLOWED_ORIGINS=http://${APP_DOMAIN}:8088
API_BASE_URL=http://api:8000

# DB SETTINGS — replace passwords before any non-local use
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# REDIS SETTINGS
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# RabbitMQ Settings — replace credentials before any non-local use
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=plane
AMQP_URL=

# TLS — leave empty for local. On prod set CERT_EMAIL and keep CERT_ACME_CA.
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
# SITE_ADDRESS is the INTERNAL Caddy listen port (inside the container). Do not change.
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_DNS=

# Django secret — generate per environment (e.g. `python -c "import secrets;print(secrets.token_urlsafe(50))"`)
SECRET_KEY=CHANGE_ME

# DATA STORE
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

GUNICORN_WORKERS=1
# DOCKER_PLATFORM=linux/amd64   # uncomment on ARM64 when stable image is amd64-only

MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT=60/minute

# WARN: set in production
LIVE_SERVER_SECRET_KEY=CHANGE_ME

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# === AI add-on (planeAI) =====================================================
# All three values are required for the ai/ Django app at runtime.
# - Generate FIELD_ENCRYPTION_KEY once per environment via:
#       python scripts/gen_encryption_key.py
#   Store it ONLY in your secrets manager (or a 600-perm .env on the host).
#   Losing it means every encrypted WorkspaceAIConfig row becomes unreadable.
# - ANTHROPIC_API_KEY / OPENAI_API_KEY are the per-project keys obtained
#   under DPA (see GDPR.md). NOT personal keys, NOT shared across envs.
FIELD_ENCRYPTION_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
